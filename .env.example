# ==========================================
# Auto-Poster Environment Configuration
# ==========================================

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# X (Twitter) API v2 Credentials (OAuth 1.0a User Context)
X_API_KEY="your-x-consumer-api-key"
X_API_SECRET="your-x-consumer-api-secret"
X_ACCESS_TOKEN="your-x-access-token"
X_ACCESS_TOKEN_SECRET="your-x-access-token-secret"
X_MONTHLY_LIMIT="500"

# Meta Threads API Credentials
THREADS_ACCESS_TOKEN="your-threads-long-lived-access-token"
THREADS_USER_ID="your-threads-user-id"

# Runtime Options
DRY_RUN="false"
# Optional overrides for manual runs:
# SLOT="morning" # or "night"
# FORCE_DAY="thursday" # or monday, tuesday, etc.
# FORCE_PILLAR="ai_hack"
